{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japan-rulewatch-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "X402_NETWORK": "eip155:84532",
    "X402_ASSET": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
    "X402_AMOUNT": "10000",
    "X402_PRICE_USD": "0.01",
    "X402_FACILITATOR_URL": "https://x402.org/facilitator",
    "X402_PAY_TO": "0x5dc8c4a19ffd5dee720c3321a307d2a948d55656"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japan-rulewatch-purchases-testnet",
      "database_id": "62253a28-bb16-4080-a1a6-bb896100ce07"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
}
